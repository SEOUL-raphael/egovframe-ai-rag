# Copy to .env in this module. The real .env is ignored.
# Use a server implementing Chat Completions; see docs/MODEL_CONFIGURATION.md.
# LLM_BASE_URL is the origin; LLM_COMPLETIONS_PATH contains the full API path.
LLM_BASE_URL=https://model-gateway.example.com
LLM_COMPLETIONS_PATH=/v1/chat/completions
LLM_API_KEY=replace-with-your-key
LLM_MODEL=replace-with-accessible-model-id
LLM_MAX_TOKENS=8192
# Optional. Leave unset to use the server's temperature behavior.
# LLM_TEMPERATURE=0.1
