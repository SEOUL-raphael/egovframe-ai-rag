# Copy this file to .env in the module directory. The real .env is ignored.
# Choose one connection described in docs/MODEL_CONFIGURATION.md.

# Local inference server (default configuration, no active profile required)
OLLAMA_BASE_URL=http://localhost:11434
WIKI_MODEL=replace-with-installed-model-id

# Remote native API (activate the minimax profile)
MINIMAX_API_KEY=replace-with-your-key
MINIMAX_API_URL=https://api.minimax.io/v1/text/chatcompletion_v2
MINIMAX_MODEL=replace-with-accessible-model-id
